# 실제 값은 .secrets/api.env 또는 각 KEY_NAME.env에 로컬 저장한다.
# 이 파일에는 값을 넣어 커밋하지 않는다. probe_apis.py는 루트 .env를 읽지 않는다.
DATA_GO_KR_SERVICE_KEY=
KAKAO_REST_API_KEY=
LAW_OC=
NAVER_API_CLIENT_ID=
NAVER_API_CLIENT_SECRET=
ODSAY_API_KEY=
# OpenAI는 제품 모델·인증·비용이 아직 검증되지 않아 현재 도구에서 사용하지 않는다.

# Vercel API 연결. 값은 .secrets/backend.env 또는 Vercel 환경변수에만 저장한다.
# Preview/Development와 Production의 Supabase 프로젝트를 구분한다.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
APP_ENV=
# 쉼표로 구분한 화면의 정확한 origin. 와일드카드는 사용하지 않는다.
ALLOWED_ORIGINS=
