# 실제 값은 .secrets/api.env 또는 각 KEY_NAME.env에 로컬 저장한다.
# 이 파일에는 값을 넣어 커밋하지 않는다. probe_apis.py는 루트 .env를 읽지 않는다.
DATA_GO_KR_SERVICE_KEY=
# 개발 서버에서 카카오 로컬과 카카오모빌리티 자동차 길찾기에 사용한다.
KAKAO_REST_API_KEY=
LAW_OC=
# 지역 뉴스 조회는 해당 서비스로 등록한 서버 환경에서 이 두 값을 사용한다.
NAVER_API_CLIENT_ID=
NAVER_API_CLIENT_SECRET=
# ODsay의 서버 플랫폼용 키. 등록된 개발 미리보기 환경에서 사용한다.
ODSAY_API_KEY=
# OpenAI는 제품 모델·인증·비용이 아직 검증되지 않아 현재 도구에서 사용하지 않는다.

# Vercel API 연결. 값은 .secrets/backend.env 또는 Vercel 환경변수에만 저장한다.
# Preview/Development와 Production의 Supabase 프로젝트를 구분한다.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
APP_ENV=
# 쉼표로 구분한 화면의 정확한 origin. 와일드카드는 사용하지 않는다.
ALLOWED_ORIGINS=
# 저장 작업과 개발 통합 검사 전용. 화면이나 Vercel 사용자 API에 주입하지 않는다.
SUPABASE_WORKER_KEY=
