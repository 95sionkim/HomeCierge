{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "typeRoots": ["./node_modules/@types"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true
  },
  "include": ["api/**/*.ts", "src/**/*.ts", "dev/**/*.ts", "tests/backend/**/*.ts"]
}
