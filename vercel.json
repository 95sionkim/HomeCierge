{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "regions": ["icn1"],
  "functions": {
    "api/index.ts": {
      "maxDuration": 30,
      "includeFiles": "node_modules/pretendard/dist/public/static/alternative/Pretendard-{Regular,Medium,SemiBold,Bold}.ttf"
    }
  },
  "rewrites": [{ "source": "/api/(.*)", "destination": "/api" }]
}
